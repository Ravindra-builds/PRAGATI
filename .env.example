# Environment Configuration for SIH Infrastructure Monitoring Prototype
# Copy this file to .env or .env.local for local development

# PostgreSQL Connection String
# Format: postgresql://[USER]:[PASSWORD]@[HOST]:[PORT]/[DATABASE]?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sih_monitoring?schema=public"

# ML Inference Microservice URL (FastAPI)
ML_SERVICE_URL="http://127.0.0.1:8000"

# Next.js Port (Default 3000)
PORT=3000

# PRAGATI Intelligence Assistant (LLM Layer) Configuration
# Supported providers: "mock" (default offline fallback), "gemini", "openai"
LLM_PROVIDER="mock"
LLM_MODEL="gemini-2.5-flash"

# Google Gemini API Configuration (if using LLM_PROVIDER="gemini")
GEMINI_API_KEY=""

# OpenAI / Compatible API Configuration (if using LLM_PROVIDER="openai" or Groq / Ollama)
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"

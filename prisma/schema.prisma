// Prisma schema for SIH 2026 Infrastructure Project Monitoring & Early Warning System

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Core infrastructure project identity and baseline sanctions.
model Project {
  id                    String          @id @default(uuid())
  projectId             String          @unique @map("project_id")
  name                  String
  ministry              String
  sector                String
  implementingAgency    String          @map("implementing_agency")
  state                 String
  originalCostCr        Float           @map("original_cost_cr")
  plannedDurationMonths Int             @map("planned_duration_months")
  status                String          // e.g., "Ongoing", "Delayed", "Critical", "Completed"
  isSynthetic           Boolean         @default(true) @map("is_synthetic")
  createdAt             DateTime        @default(now()) @map("created_at")
  updatedAt             DateTime        @updatedAt @map("updated_at")

  // Relationships
  updates               ProjectUpdate[]
  predictions           Prediction[]
  warnings              EarlyWarning[]

  @@map("projects")
}

/// Monthly monitoring snapshots. Strictly stores observation-time features only (no target outcomes).
model ProjectUpdate {
  id                   String         @id @default(uuid())
  projectId            String         @map("project_id")
  snapshotMonth        String         @map("snapshot_month") // Format: YYYY-MM
  elapsedMonths        Int            @map("elapsed_months")
  physicalProgressPct  Float          @map("physical_progress_pct")
  financialProgressPct Float          @map("financial_progress_pct")
  expenditureCr        Float          @map("expenditure_cr")
  milestonesTotal      Int            @map("milestones_total")
  milestonesDelayed    Int            @map("milestones_delayed")
  projectStatus        String         @map("project_status")
  createdAt            DateTime       @default(now()) @map("created_at")

  // Relationships
  project              Project        @relation(fields: [projectId], references: [projectId], onDelete: Cascade)
  predictions          Prediction[]
  warnings             EarlyWarning[]

  @@unique([projectId, snapshotMonth])
  @@index([projectId])
  @@map("project_updates")
}

/// Inference outputs generated by the dual-target ML service.
model Prediction {
  id                      String         @id @default(uuid())
  projectId               String         @map("project_id")
  projectUpdateId         String         @map("project_update_id")
  costOverrunProbability  Float          @map("cost_overrun_probability")
  costPrediction          Int            @map("cost_prediction") // 0 = Within Tolerance, 1 = Overrun
  timeOverrunProbability  Float          @map("time_overrun_probability")
  timePrediction          Int            @map("time_prediction") // 0 = On Time, 1 = Delayed
  costModelVersion        String         @map("cost_model_version")
  timeModelVersion        String         @map("time_model_version")
  overallRiskLevel        String         @map("overall_risk_level") // "LOW", "MEDIUM", "HIGH"
  createdAt               DateTime       @default(now()) @map("created_at")

  // Relationships
  project                 Project        @relation(fields: [projectId], references: [projectId], onDelete: Cascade)
  projectUpdate           ProjectUpdate  @relation(fields: [projectUpdateId], references: [id], onDelete: Cascade)
  warnings                EarlyWarning[]

  @@index([projectId])
  @@index([projectUpdateId])
  @@map("predictions")
}

/// Application-level early warning alerts triggered by model predictions or indicator slippage.
model EarlyWarning {
  id              String         @id @default(uuid())
  projectId       String         @map("project_id")
  projectUpdateId String?        @map("project_update_id")
  predictionId    String?        @map("prediction_id")
  warningType     String         @map("warning_type") // e.g., "COST_OVERRUN_RISK", "SCHEDULE_DELAY_RISK", "CRITICAL_MILESTONE_SLIPPAGE", "EXPENDITURE_BURN_ANOMALY"
  severity        String         // "LOW", "MEDIUM", "HIGH", "CRITICAL"
  title           String
  message         String
  createdAt       DateTime       @default(now()) @map("created_at")
  resolvedAt      DateTime?      @map("resolved_at")

  // Relationships
  project         Project        @relation(fields: [projectId], references: [projectId], onDelete: Cascade)
  projectUpdate   ProjectUpdate? @relation(fields: [projectUpdateId], references: [id], onDelete: SetNull)
  prediction      Prediction?    @relation(fields: [predictionId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([warningType])
  @@map("early_warnings")
}
